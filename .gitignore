# raw + processed data are large and provided separately - every teammate keeps a local copy
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# reserved evaluation trips (with their reference routes) stay only on laptop 1
data/evaluation/*
!data/evaluation/.gitkeep
**/evaluator_test/

# runtime log of the API (screenshots go in the report instead)
outputs/api_logs/*.log

__pycache__/
*.pyc
.venv/
.DS_Store
.ipynb_checkpoints/
.env

# Team-internal files (do not upload)
/GIT_PUSH_PLAN.md
/CONTRIBUTIONS.md
